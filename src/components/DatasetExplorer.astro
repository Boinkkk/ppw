---
// Komponen Penjelajah Dataset Interaktif (Client-side Data Table)
---

<div class="dataset-explorer-container not-content">
  <!-- Tab Kategori -->
  <div class="tabs-header">
    <button class="tab-btn active" data-category="sport" id="tab-sport">
      <span class="tab-icon">⚽</span>
      <span>Detik Sport</span>
      <span class="badge" id="badge-sport">392 data</span>
    </button>
    <button class="tab-btn" data-category="finance" id="tab-finance">
      <span class="tab-icon">💼</span>
      <span>Detik Finance</span>
      <span class="badge" id="badge-finance">386 data</span>
    </button>
  </div>

  <!-- Toolbar: Pencarian, Jumlah per halaman & Tombol Download -->
  <div class="toolbar">
    <div class="search-box">
      <svg class="search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
      <input type="text" id="dataset-search" placeholder="Cari judul atau isi berita..." />
      <button id="clear-search" class="clear-btn" style="display: none;">&times;</button>
    </div>

    <div class="toolbar-actions">
      <div class="per-page-wrapper">
        <label for="per-page-select">Tampilkan:</label>
        <select id="per-page-select">
          <option value="10">10</option>
          <option value="25" selected>25</option>
          <option value="50">50</option>
        </select>
      </div>

      <div class="download-buttons">
        <a id="download-csv" href="/ppw/data/hasil_scraping_detik_sport.csv" download class="action-btn csv-btn" title="Unduh CSV">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="7 10 12 15 17 10"></polyline>
            <line x1="12" y1="15" x2="12" y2="3"></line>
          </svg>
          <span>CSV</span>
        </a>
        <a id="download-json" href="/ppw/data/hasil_scraping_detik_sport.json" download class="action-btn json-btn" title="Unduh JSON">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="7 10 12 15 17 10"></polyline>
            <line x1="12" y1="15" x2="12" y2="3"></line>
          </svg>
          <span>JSON</span>
        </a>
      </div>
    </div>
  </div>

  <!-- Loading State -->
  <div id="dataset-loading" class="loading-state">
    <div class="spinner"></div>
    <p>Memuat data artikel...</p>
  </div>

  <!-- Tabel Data Responsif -->
  <div class="table-responsive" id="table-wrapper" style="display: none;">
    <table class="dataset-table">
      <thead>
        <tr>
          <th style="width: 50px;">No</th>
          <th style="width: 32%;">Judul Berita</th>
          <th style="width: 18%;">Waktu Publikasi</th>
          <th style="width: 38%;">Cuplikan Isi Berita</th>
          <th style="width: 12%; text-align: center;">Aksi</th>
        </tr>
      </thead>
      <tbody id="dataset-tbody">
        <!-- Diisi secara dinamis via JavaScript -->
      </tbody>
    </table>
  </div>

  <!-- Empty State jika pencarian tidak ditemukan -->
  <div id="dataset-empty" class="empty-state" style="display: none;">
    <p>Tidak ada artikel yang cocok dengan kata kunci pencarian Anda.</p>
  </div>

  <!-- Paginasi & Info -->
  <div class="pagination-container" id="pagination-wrapper" style="display: none;">
    <div class="pagination-info" id="pagination-info">
      Menampilkan 0 - 0 dari 0 artikel
    </div>
    <div class="pagination-controls" id="pagination-controls">
      <!-- Tombol halaman di-generate otomatis -->
    </div>
  </div>

  <!-- Modal Pop-up Baca Berita Lengkap -->
  <dialog id="article-modal" class="article-modal">
    <div class="modal-content">
      <div class="modal-header">
        <h3 id="modal-title">Judul Berita</h3>
        <button id="modal-close" class="modal-close-btn" aria-label="Tutup">&times;</button>
      </div>
      <div class="modal-meta">
        <span class="meta-item">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"></circle>
            <polyline points="12 6 12 12 16 14"></polyline>
          </svg>
          <span id="modal-time">-</span>
        </span>
        <a id="modal-link" href="#" target="_blank" rel="noopener noreferrer" class="external-link">
          <span>Buka di Detikcom</span>
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
            <polyline points="15 3 21 3 21 9"></polyline>
            <line x1="10" y1="14" x2="21" y2="3"></line>
          </svg>
        </a>
      </div>
      <div class="modal-body">
        <p id="modal-content" class="article-full-text"></p>
      </div>
    </div>
  </dialog>
</div>

<style>
  .dataset-explorer-container {
    margin: 2rem 0;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 12px;
    background-color: var(--sl-color-bg-nav);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
    overflow: hidden;
    font-family: inherit;
  }

  /* Tabs Header */
  .tabs-header {
    display: flex;
    border-bottom: 1px solid var(--sl-color-gray-5);
    background-color: var(--sl-color-bg-sidebar);
  }

  .tab-btn {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 14px 20px;
    background: transparent;
    border: none;
    border-bottom: 3px solid transparent;
    font-size: 1rem;
    font-weight: 600;
    color: var(--sl-color-gray-3);
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .tab-btn:hover {
    color: var(--sl-color-white);
    background-color: rgba(255, 255, 255, 0.03);
  }

  .tab-btn.active {
    color: var(--sl-color-accent-high, #3b82f6);
    border-bottom-color: var(--sl-color-accent, #3b82f6);
    background-color: var(--sl-color-bg-nav);
  }

  .tab-btn .badge {
    font-size: 0.75rem;
    padding: 2px 8px;
    border-radius: 12px;
    background-color: var(--sl-color-gray-5);
    color: var(--sl-color-gray-2);
  }

  .tab-btn.active .badge {
    background-color: var(--sl-color-accent-low, rgba(59, 130, 246, 0.15));
    color: var(--sl-color-accent-high, #3b82f6);
  }

  /* Toolbar */
  .toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 16px 20px;
    border-bottom: 1px solid var(--sl-color-gray-5);
  }

  .search-box {
    position: relative;
    flex: 1;
    min-width: 250px;
    max-width: 450px;
  }

  .search-icon {
    position: absolute;
    left: 12px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--sl-color-gray-3);
  }

  .search-box input {
    width: 100%;
    padding: 8px 36px 8px 36px;
    border: 1px solid var(--sl-color-gray-4);
    border-radius: 8px;
    background-color: var(--sl-color-bg);
    color: var(--sl-color-white);
    font-size: 0.9rem;
    outline: none;
    transition: border-color 0.2s;
  }

  .search-box input:focus {
    border-color: var(--sl-color-accent, #3b82f6);
  }

  .clear-btn {
    position: absolute;
    right: 10px;
    top: 50%;
    transform: translateY(-50%);
    background: transparent;
    border: none;
    font-size: 1.2rem;
    color: var(--sl-color-gray-3);
    cursor: pointer;
  }

  .toolbar-actions {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .per-page-wrapper {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.85rem;
    color: var(--sl-color-gray-2);
  }

  .per-page-wrapper select {
    padding: 6px 10px;
    border: 1px solid var(--sl-color-gray-4);
    border-radius: 6px;
    background-color: var(--sl-color-bg);
    color: var(--sl-color-white);
    font-size: 0.85rem;
    cursor: pointer;
  }

  .download-buttons {
    display: flex;
    gap: 8px;
  }

  .action-btn {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 6px 12px;
    font-size: 0.8rem;
    font-weight: 600;
    text-decoration: none;
    border-radius: 6px;
    border: 1px solid var(--sl-color-gray-4);
    color: var(--sl-color-white);
    background-color: var(--sl-color-bg);
    transition: all 0.2s;
  }

  .action-btn:hover {
    background-color: var(--sl-color-accent-low, rgba(59, 130, 246, 0.15));
    border-color: var(--sl-color-accent, #3b82f6);
    color: var(--sl-color-accent-high, #3b82f6);
  }

  /* Table */
  .table-responsive {
    width: 100%;
    overflow-x: auto;
  }

  .dataset-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
    text-align: left;
  }

  .dataset-table th {
    padding: 12px 16px;
    background-color: var(--sl-color-bg-sidebar);
    color: var(--sl-color-gray-2);
    font-weight: 600;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border-bottom: 1px solid var(--sl-color-gray-5);
  }

  .dataset-table td {
    padding: 12px 16px;
    border-bottom: 1px solid var(--sl-color-gray-6, rgba(255, 255, 255, 0.05));
    vertical-align: top;
    line-height: 1.5;
  }

  .dataset-table tr:hover {
    background-color: rgba(255, 255, 255, 0.02);
  }

  .article-title-link {
    color: var(--sl-color-white);
    font-weight: 600;
    text-decoration: none;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .article-title-link:hover {
    color: var(--sl-color-accent-high, #3b82f6);
    text-decoration: underline;
  }

  .article-time {
    color: var(--sl-color-gray-3);
    font-size: 0.8rem;
    white-space: nowrap;
  }

  .article-snippet {
    color: var(--sl-color-gray-2);
    font-size: 0.85rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .view-btn {
    padding: 5px 10px;
    font-size: 0.8rem;
    border-radius: 4px;
    border: 1px solid var(--sl-color-accent, #3b82f6);
    background-color: var(--sl-color-accent-low, rgba(59, 130, 246, 0.15));
    color: var(--sl-color-accent-high, #3b82f6);
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.2s;
  }

  .view-btn:hover {
    background-color: var(--sl-color-accent, #3b82f6);
    color: #ffffff;
  }

  /* Loading & Empty State */
  .loading-state, .empty-state {
    padding: 40px 20px;
    text-align: center;
    color: var(--sl-color-gray-3);
  }

  .spinner {
    width: 32px;
    height: 32px;
    margin: 0 auto 12px;
    border: 3px solid var(--sl-color-gray-5);
    border-top-color: var(--sl-color-accent, #3b82f6);
    border-radius: 50%;
    animation: spin 1s linear infinite;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  /* Pagination */
  .pagination-container {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 14px 20px;
    border-top: 1px solid var(--sl-color-gray-5);
    font-size: 0.85rem;
    color: var(--sl-color-gray-2);
  }

  .pagination-controls {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .page-btn {
    min-width: 32px;
    height: 32px;
    padding: 0 6px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 6px;
    border: 1px solid var(--sl-color-gray-5);
    background-color: var(--sl-color-bg);
    color: var(--sl-color-white);
    font-size: 0.85rem;
    cursor: pointer;
    transition: all 0.2s;
  }

  .page-btn:hover:not(:disabled) {
    border-color: var(--sl-color-accent, #3b82f6);
    color: var(--sl-color-accent-high, #3b82f6);
  }

  .page-btn.active {
    background-color: var(--sl-color-accent, #3b82f6);
    border-color: var(--sl-color-accent, #3b82f6);
    color: #ffffff;
    font-weight: 600;
  }

  .page-btn:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }

  /* Modal Dialog */
  .article-modal {
    max-width: 750px;
    width: 90%;
    border: 1px solid var(--sl-color-gray-4);
    border-radius: 12px;
    background-color: var(--sl-color-bg-nav);
    color: var(--sl-color-text);
    padding: 0;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
  }

  .article-modal::backdrop {
    background: rgba(0, 0, 0, 0.7);
    backdrop-filter: blur(3px);
  }

  .modal-content {
    display: flex;
    flex-direction: column;
    max-height: 80vh;
  }

  .modal-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
    padding: 20px 24px;
    border-bottom: 1px solid var(--sl-color-gray-5);
  }

  .modal-header h3 {
    margin: 0;
    font-size: 1.25rem;
    line-height: 1.4;
    color: var(--sl-color-white);
  }

  .modal-close-btn {
    background: transparent;
    border: none;
    font-size: 1.5rem;
    color: var(--sl-color-gray-3);
    cursor: pointer;
    line-height: 1;
  }

  .modal-close-btn:hover {
    color: var(--sl-color-white);
  }

  .modal-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 10px 24px;
    background-color: var(--sl-color-bg-sidebar);
    font-size: 0.85rem;
    color: var(--sl-color-gray-3);
    border-bottom: 1px solid var(--sl-color-gray-5);
  }

  .meta-item {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .external-link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    color: var(--sl-color-accent-high, #3b82f6);
    text-decoration: none;
  }

  .external-link:hover {
    text-decoration: underline;
  }

  .modal-body {
    padding: 20px 24px;
    overflow-y: auto;
  }

  .article-full-text {
    line-height: 1.8;
    color: var(--sl-color-gray-1);
    white-space: pre-line;
    margin: 0;
    text-align: justify;
  }
</style>

<script is:inline>
  (function () {
    let currentCategory = 'sport';
    let rawData = { sport: [], finance: [] };
    let filteredData = [];
    let currentPage = 1;
    let perPage = 25;

    const endpoints = {
      sport: '/ppw/data/hasil_scraping_detik_sport.json',
      finance: '/ppw/data/hasil_scraping_detik_finance.json'
    };

    const downloadUrls = {
      sport: {
        csv: '/ppw/data/hasil_scraping_detik_sport.csv',
        json: '/ppw/data/hasil_scraping_detik_sport.json'
      },
      finance: {
        csv: '/ppw/data/hasil_scraping_detik_finance.csv',
        json: '/ppw/data/hasil_scraping_detik_finance.json'
      }
    };

    // DOM Elements
    const tabSport = document.getElementById('tab-sport');
    const tabFinance = document.getElementById('tab-finance');
    const searchInput = document.getElementById('dataset-search');
    const clearBtn = document.getElementById('clear-search');
    const perPageSelect = document.getElementById('per-page-select');
    const downloadCsv = document.getElementById('download-csv');
    const downloadJson = document.getElementById('download-json');
    const loadingState = document.getElementById('dataset-loading');
    const tableWrapper = document.getElementById('table-wrapper');
    const tbody = document.getElementById('dataset-tbody');
    const emptyState = document.getElementById('dataset-empty');
    const paginationWrapper = document.getElementById('pagination-wrapper');
    const paginationInfo = document.getElementById('pagination-info');
    const paginationControls = document.getElementById('pagination-controls');
    const modal = document.getElementById('article-modal');
    const modalTitle = document.getElementById('modal-title');
    const modalTime = document.getElementById('modal-time');
    const modalLink = document.getElementById('modal-link');
    const modalContent = document.getElementById('modal-content');
    const modalClose = document.getElementById('modal-close');

    async function loadData(category) {
      if (rawData[category] && rawData[category].length > 0) {
        applyFilter();
        return;
      }

      loadingState.style.display = 'block';
      tableWrapper.style.display = 'none';
      emptyState.style.display = 'none';
      paginationWrapper.style.display = 'none';

      try {
        const res = await fetch(endpoints[category]);
        if (!res.ok) throw new Error('Gagal memuat dataset: ' + res.status);
        const json = await res.json();
        rawData[category] = json;
        
        // Update badge
        const badge = document.getElementById('badge-' + category);
        if (badge) badge.textContent = json.length + ' data';

        applyFilter();
      } catch (err) {
        loadingState.innerHTML = '<p style="color: red;">Error: ' + err.message + '</p>';
      }
    }

    function applyFilter() {
      loadingState.style.display = 'none';
      const query = (searchInput.value || '').toLowerCase().trim();
      const currentList = rawData[currentCategory] || [];

      if (!query) {
        filteredData = currentList;
      } else {
        filteredData = currentList.filter(function (item) {
          const title = (item.judul || '').toLowerCase();
          const body = (item.isi_berita || '').toLowerCase();
          return title.includes(query) || body.includes(query);
        });
      }

      currentPage = 1;
      renderTable();
    }

    function renderTable() {
      const total = filteredData.length;

      if (total === 0) {
        tableWrapper.style.display = 'none';
        emptyState.style.display = 'block';
        paginationWrapper.style.display = 'none';
        return;
      }

      emptyState.style.display = 'none';
      tableWrapper.style.display = 'block';
      paginationWrapper.style.display = 'flex';

      const totalPages = Math.ceil(total / perPage);
      if (currentPage > totalPages) currentPage = totalPages;
      if (currentPage < 1) currentPage = 1;

      const startIndex = (currentPage - 1) * perPage;
      const endIndex = Math.min(startIndex + perPage, total);
      const pageData = filteredData.slice(startIndex, endIndex);

      // Render Rows
      let html = '';
      pageData.forEach(function (item, idx) {
        const itemNumber = startIndex + idx + 1;
        const judul = item.judul || 'Tanpa Judul';
        const link = item.link || '#';
        const waktu = item.waktu || '-';
        const isi = item.isi_berita || '';
        const snippet = isi.length > 150 ? isi.slice(0, 150) + '...' : isi;

        html += '<tr>';
        html += '<td style="color: var(--sl-color-gray-3); text-align: center;">' + itemNumber + '</td>';
        html += '<td><a href="' + link + '" target="_blank" rel="noopener noreferrer" class="article-title-link" title="' + judul.replace(/"/g, '&quot;') + '">' + judul + '</a></td>';
        html += '<td class="article-time">' + waktu + '</td>';
        html += '<td><span class="article-snippet">' + (snippet || '<em>(Tidak ada konten teks)</em>') + '</span></td>';
        html += '<td style="text-align: center;"><button class="view-btn" data-index="' + (startIndex + idx) + '">Baca</button></td>';
        html += '</tr>';
      });

      tbody.innerHTML = html;

      // Bind view buttons
      const viewButtons = tbody.querySelectorAll('.view-btn');
      viewButtons.forEach(function (btn) {
        btn.addEventListener('click', function () {
          const dataIdx = parseInt(this.getAttribute('data-index'));
          const item = filteredData[dataIdx];
          if (!item) return;

          modalTitle.textContent = item.judul || '';
          modalTime.textContent = item.waktu || '-';
          modalLink.href = item.link || '#';
          modalContent.textContent = item.isi_berita || '(Tidak ada isi berita)';
          if (modal.showModal) {
            modal.showModal();
          } else {
            modal.style.display = 'block';
          }
        });
      });

      // Render Pagination Info
      paginationInfo.textContent = 'Menampilkan ' + (startIndex + 1) + ' - ' + endIndex + ' dari ' + total + ' artikel';

      // Render Pagination Buttons
      renderPaginationControls(totalPages);
    }

    function renderPaginationControls(totalPages) {
      if (totalPages <= 1) {
        paginationControls.innerHTML = '';
        return;
      }

      let btnHtml = '';
      
      // Prev Button
      btnHtml += '<button class="page-btn" id="page-prev"' + (currentPage === 1 ? ' disabled' : '') + '>&laquo;</button>';

      // Page numbers logic (max 5 buttons visible)
      let startP = Math.max(1, currentPage - 2);
      let endP = Math.min(totalPages, startP + 4);
      if (endP - startP < 4) {
        startP = Math.max(1, endP - 4);
      }

      if (startP > 1) {
        btnHtml += '<button class="page-btn" data-page="1">1</button>';
        if (startP > 2) btnHtml += '<span style="padding: 0 4px; color: var(--sl-color-gray-4);">...</span>';
      }

      for (let p = startP; p <= endP; p++) {
        btnHtml += '<button class="page-btn' + (p === currentPage ? ' active' : '') + '" data-page="' + p + '">' + p + '</button>';
      }

      if (endP < totalPages) {
        if (endP < totalPages - 1) btnHtml += '<span style="padding: 0 4px; color: var(--sl-color-gray-4);">...</span>';
        btnHtml += '<button class="page-btn" data-page="' + totalPages + '">' + totalPages + '</button>';
      }

      // Next Button
      btnHtml += '<button class="page-btn" id="page-next"' + (currentPage === totalPages ? ' disabled' : '') + '>&raquo;</button>';

      paginationControls.innerHTML = btnHtml;

      // Event listeners for pagination buttons
      paginationControls.querySelectorAll('button[data-page]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          currentPage = parseInt(this.getAttribute('data-page'));
          renderTable();
          tableWrapper.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        });
      });

      const prevBtn = document.getElementById('page-prev');
      if (prevBtn) {
        prevBtn.addEventListener('click', function () {
          if (currentPage > 1) {
            currentPage--;
            renderTable();
            tableWrapper.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
          }
        });
      }

      const nextBtn = document.getElementById('page-next');
      if (nextBtn) {
        nextBtn.addEventListener('click', function () {
          if (currentPage < totalPages) {
            currentPage++;
            renderTable();
            tableWrapper.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
          }
        });
      }
    }

    function switchTab(category) {
      if (currentCategory === category) return;
      currentCategory = category;

      if (category === 'sport') {
        tabSport.classList.add('active');
        tabFinance.classList.remove('active');
      } else {
        tabFinance.classList.add('active');
        tabSport.classList.remove('active');
      }

      // Update download links
      downloadCsv.href = downloadUrls[category].csv;
      downloadJson.href = downloadUrls[category].json;

      searchInput.value = '';
      clearBtn.style.display = 'none';

      loadData(category);
    }

    // Event Listeners
    tabSport.addEventListener('click', function () { switchTab('sport'); });
    tabFinance.addEventListener('click', function () { switchTab('finance'); });

    searchInput.addEventListener('input', function () {
      clearBtn.style.display = this.value ? 'block' : 'none';
      applyFilter();
    });

    clearBtn.addEventListener('click', function () {
      searchInput.value = '';
      this.style.display = 'none';
      applyFilter();
    });

    perPageSelect.addEventListener('change', function () {
      perPage = parseInt(this.value);
      currentPage = 1;
      renderTable();
    });

    modalClose.addEventListener('click', function () {
      if (modal.close) {
        modal.close();
      } else {
        modal.style.display = 'none';
      }
    });

    modal.addEventListener('click', function (e) {
      if (e.target === modal) {
        if (modal.close) modal.close();
        else modal.style.display = 'none';
      }
    });

    // Inisialisasi awal
    loadData('sport');
  })();
</script>
